# ============================================================
# NESBox 私有化部署环境变量模板
# 使用: cp .env.example .env  然后按需修改
# ============================================================

# ------------------------------------------------------------
# 必填：安全相关
# ------------------------------------------------------------

# PostgreSQL 超级用户密码（首次启动初始化数据库时使用）
# 建议使用强随机密码，例如: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password

# JWT 签名密钥，用于用户 token 签发与校验
# 必须设置为随机字符串，例如: openssl rand -hex 32
# 修改后所有已登录用户需要重新登录
SECRET=change-me-random-secret

# ------------------------------------------------------------
# 选填：数据库
# ------------------------------------------------------------

POSTGRES_USER=nesbox
POSTGRES_DB=nesbox

# ------------------------------------------------------------
# 选填：对外访问
# ------------------------------------------------------------

# webapp 容器对外暴露的 HTTP 端口
# 如果宿主机 8080 已被占用，可改为其他端口
WEBAPP_PORT=18080

# ------------------------------------------------------------
# 选填：前端构建参数
# 这些值会在 docker build 阶段被静态注入到前端 bundle
# 修改后需要重新构建 webapp 镜像: docker compose build webapp
# ------------------------------------------------------------

# 前端调用后端 API 的基路径
# 默认 /api，nginx 会将 /api/* 反代到 server:8080/*
API_BASE=/api

# 外部资源 CORS 代理域名
# off: 禁用代理，使用相对路径（私有化部署推荐，资源已本地化）
# 留空: 使用官方默认代理 https://files.xianqiao.wang
# 其他值: 使用指定的代理域名
CORS_ORIGIN=off

# AI 搜索服务地址（Cloudflare Worker）
# 留空: 禁用 AI 搜索（推荐，私有化部署无 CF Worker）
# 非空: 例如 https://nesbox.709922234.workers.dev
AI_SEARCH_BASE=

# AI 问答补全服务地址（Cloudflare Worker）
# 留空: 禁用 AI 问答，前端显示 "AI service is not configured"
# 非空: 例如 https://nesbox.709922234.workers.dev
AI_COMPLETIONS_BASE=

# ------------------------------------------------------------
# 选填：后端行为
# ------------------------------------------------------------

# 游戏数据同步 URL（GitHub Issue webhook 触发时向此地址 POST）
# off 或空: 禁用同步（推荐，私有化部署无 CF Worker）
# 非空: 例如 https://nesbox.709922234.workers.dev
GAMES_SYNC_URL=off

# Rust 日志级别: error / warn / info / debug / trace
RUST_LOG=info

# ------------------------------------------------------------
# 选填：本地化脚本
# scripts/localize-games.mjs 与 localize-incremental.mjs 使用
# ------------------------------------------------------------

# 官方 NESBox API 地址（guestgraphql 端点，无需认证）
# 用于获取最新游戏数据（164 条游戏）
NESBOX_API_URL=https://api.xianqiao.wang/nesbox/guestgraphql

# 本地化后资源在 nginx 中的 URL 前缀
# 与 docker-compose.yml 中 webapp 挂载路径保持一致
LOCAL_FILES_URL_PREFIX=/files

# 下载并发数（NAS 设备建议 4-8，避免占满带宽）
LOCALIZE_CONCURRENCY=6

# 下载失败重试次数
LOCALIZE_RETRIES=3
